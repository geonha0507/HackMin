<?xml version="1.0" encoding="utf-8"?>
<!-- 음식점 상세 메뉴 목록 맨 아래 "유의사항" 푸터. 마지막 문구엔 매장 이름이 들어감. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F4F4F4"
    android:padding="20dp"
    android:layout_marginTop="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="유의사항"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="• 메뉴 사진은 실제 조리된 음식과 다를 수 있습니다."
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="• 상단 메뉴 및 가격은 업소에서 제공한 정보를 기준으로 작성되었으며 변동될 수 있습니다."
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="• 메뉴별 리뷰 개수는 해당 메뉴가 포함된 주문에 대하여 고객이 남겨주신 리뷰를 기반으로 산출된 것입니다."
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:id="@+id/tv_notice_disclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="3dp" />

</LinearLayout>
