<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_revert"
            android:background="@android:color/transparent"
            android:contentDescription="뒤로가기" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="멤버십"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 현재 상태 -->
            <TextView
                android:id="@+id/tvMembershipStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="가입 상태를 확인하는 중..."
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/coral_primary"
                android:padding="16dp"
                android:background="#F3EEFA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="멤버십 혜택"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212529"
                android:layout_marginTop="24dp" />

            <!-- 혜택 목록 (동적 추가) -->
            <LinearLayout
                android:id="@+id/containerBenefits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="15sp"
                android:textColor="#212529"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="멤버십 가입하기"
        android:backgroundTint="@color/coral_primary"
        android:textColor="#FFFFFF" />

    <include layout="@layout/bottom_nav"/>

</LinearLayout>
