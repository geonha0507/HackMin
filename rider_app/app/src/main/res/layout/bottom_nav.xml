<?xml version="1.0" encoding="utf-8"?>
<!-- 공용 하단 네비게이션 바 (홈 · 운행 · 수입 · 내정보). BottomNav.setup()으로 연결. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_nav_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_dim"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- 홈 -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_home"
                app:tint="@color/text_secondary"
                android:contentDescription="홈"/>

            <TextView
                android:id="@+id/nav_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="홈"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- 운행 -->
        <LinearLayout
            android:id="@+id/nav_delivery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/nav_delivery_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_scooter"
                    app:tint="@color/text_secondary"
                    android:contentDescription="운행"/>

                <TextView
                    android:id="@+id/tv_delivery_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:minWidth="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_notice_badge"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>

            </FrameLayout>

            <TextView
                android:id="@+id/nav_delivery_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="운행"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- 수입 -->
        <LinearLayout
            android:id="@+id/nav_earnings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/nav_earnings_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_wallet"
                app:tint="@color/text_secondary"
                android:contentDescription="수입"/>

            <TextView
                android:id="@+id/nav_earnings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="수입"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- 내정보 -->
        <LinearLayout
            android:id="@+id/nav_mypage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/nav_mypage_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_person"
                app:tint="@color/text_secondary"
                android:contentDescription="내정보"/>

            <TextView
                android:id="@+id/nav_mypage_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="내정보"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
