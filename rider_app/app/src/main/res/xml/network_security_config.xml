<?xml version="1.0" encoding="utf-8"?>
<!--
  hackmin.com TLS 정책.

  인증서는 ACM 발급(ALB 종단)이라 갱신 때마다 키페어가 새로 생성된다.
  따라서 리프/중간 인증서를 핀하면 ACM 자동 갱신 순간 설치된 앱이 전부
  통신 불가가 된다. 갱신을 넘어 살아남는 Amazon 루트 CA를 핀한다.
  (Amazon Root CA 1 만료: 2037-12-31)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config>
        <domain includeSubdomains="true">hackmin.com</domain>
        <!--
          루트 4개를 모두 넣는 이유: 지금 체인은 Root CA 1(RSA)이지만 ACM에서
          ECDSA 인증서로 바꾸면 Root CA 3 쪽으로 붙는다. 미리 넣어두면 그때
          앱이 죽지 않는다. 넷 다 Amazon 루트라 신뢰 범위는 그대로다.

          expiration 이후에는 핀 검사가 fail-open 된다(앱 벽돌 방지 안전판).
          릴리즈할 때마다 날짜를 앞으로 밀어준다.
        -->
        <pin-set expiration="2027-12-31">
            <!-- Amazon Root CA 1 (현재 체인) -->
            <pin digest="SHA-256">++MBgDH5WGvL9Bcn5Be30cRcL0f5O+NyoXuWtQdX1aI=</pin>
            <!-- Amazon Root CA 2 (백업) -->
            <pin digest="SHA-256">f0KW/FtqTjs108NpYj42SrGvOB2PpxIVM8nWxjPqJGE=</pin>
            <!-- Amazon Root CA 3 (백업, ECDSA) -->
            <pin digest="SHA-256">NqvDJlas/GRcYbcWE8S/IceH9cq77kg0jVhZeAPXq8k=</pin>
            <!-- Amazon Root CA 4 (백업, ECDSA) -->
            <pin digest="SHA-256">9+ze1cZgR9KO1kZrVDxA4HQ6voHRCSVNz4RdTCx4U8U=</pin>
        </pin-set>
    </domain-config>

    <!-- 디버그 빌드에서만 사용자 설치 CA(Burp 등)를 신뢰한다. 릴리즈에는 적용되지 않는다. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
