# 점주 웹(BFF) 전용 이미지 — 3-tier 분리 PoC.
#
# 루트의 Dockerfile(API 이미지)과 의도적으로 분리했다. 이 이미지에는
# apps/ 도 config/ 도 들어가지 않는다. 즉 모델·시리얼라이저·비즈니스 로직이
# 이 컨테이너 안에 아예 존재하지 않으므로, 침해당해도 노출될 코드가 없다.
#
# DB 드라이버도 넣지 않는다 (mysqlclient 없음). 설령 코드가 ORM 을 호출해도
# 커넥션을 열 수단 자체가 없다.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# API 이미지와 의존성이 다르다. Django + httpx + redis 뿐이다.
COPY requirements-web.txt /tmp/requirements-web.txt
RUN pip install --no-cache-dir -r /tmp/requirements-web.txt \
    && rm -f /tmp/requirements-web.txt

COPY manage_web.py ./
# 인증·API 호출 레이어는 admin_bff 와 공유한다.
COPY bff_core/ ./bff_core/
COPY web_bff/ ./web_bff/

EXPOSE 8000

CMD ["python", "manage_web.py", "runserver", "0.0.0.0:8000"]
