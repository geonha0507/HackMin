# 저장소에는 항상 LF 로 저장한다.
# Windows 에디터나 GitHub Desktop 이 CRLF 로 저장해도 diff 가 파일 전체
# 재작성으로 보이지 않게 하기 위한 설정이다.
* text=auto eol=lf

# 컨테이너 안에서 실행되는 스크립트는 반드시 LF 여야 한다.
# (CRLF 면 `/usr/bin/env bash\r` 로 해석돼 exec 가 실패한다)
*.sh text eol=lf

# Windows 전용 스크립트만 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf
gradlew text eol=lf

# 바이너리는 손대지 않는다.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.apk  binary
*.aab  binary
*.jar  binary
*.keystore binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.sqlite3 binary
