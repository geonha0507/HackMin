# cp .env.example .env 후 값 채우기
#
# 로컬 개발용 예시. 운영(EC2)의 .env 는 GitHub Actions 가 배포 시
# 자동 생성하므로 직접 편집하지 않는다 (docs/DEPLOYMENT.md 참고).

# --- 설정 프로파일 ---------------------------------------------------------
# dev: 랩/개발 기본값 (DEBUG, ALLOWED_HOSTS=*, CORS 전체 허용)
# prod: 보안 하드닝 (HTTPS 종단·ALLOWED_HOSTS 설정이 끝난 뒤에 전환)
DJANGO_ENV=dev
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=django-insecure-dev-key

# prod 프로파일에서만 사용. 콤마 구분.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_ORIGINS=
DJANGO_CORS_ORIGINS=
DJANGO_SSL_REDIRECT=0

# --- 데이터베이스 -----------------------------------------------------------
# sqlite(기본) 또는 mysql(RDS)
DB_ENGINE=sqlite
DB_SQLITE_PATH=
DB_NAME=hackmin
DB_USER=hackmin
DB_PASSWORD=changeme
DB_HOST=
DB_PORT=3306
# RDS 에 SSL 강제 연결이 필요할 때만 채운다.
# docker-compose.yml 이 프로젝트 최상위의 global-bundle.pem 을 컨테이너의
# /app/certs/rds-ca.pem 으로 읽기 전용 마운트하므로, 값은 컨테이너 안 경로를 쓴다.
#   DB_SSL_CA=/app/certs/rds-ca.pem
# 번들이 없으면 받아둔다 (없으면 도커가 같은 이름의 빈 디렉터리를 만든다):
#   curl -o global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_SSL_CA=
# CA 번들이 다른 곳에 있으면 호스트 경로를 지정 (기본: ./global-bundle.pem)
# RDS_CA_PATH=

# --- 파일 스토리지 ----------------------------------------------------------
# 0이면 컨테이너 로컬 media/, 1이면 S3
USE_S3=0
AWS_S3_BUCKET_NAME=hackmin-media-bucket
AWS_S3_REGION_NAME=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- 챗봇 (OpenRouter → GPT-4o-mini) ----------------------------------------
OPENAI_API_KEY=

# --- 데모 데이터 -------------------------------------------------------------
# 컨테이너 최초 기동 시 데모 계정/데이터 생성
# (admin/alice/bob/owner/rider, 비밀번호 pw1234)
SEED_DEMO=1

# --- 점주 웹 (web, 8001) ------------------------------------------------------
# DB 에 접속하지 않고 /api/v1 만 호출하는 컨테이너. 세션은 redis 에 저장한다.
# 로그인 POST 가 CSRF 로 막히지 않도록 실제 접속 주소를 넣는다.
# 스킴까지 정확히 적어야 한다. nginx 로 HTTPS 를 쓰면 https:// 를 반드시 포함할 것.
#   WEB_BFF_CSRF_ORIGINS=https://54.116.95.188,http://54.116.95.188
WEB_BFF_CSRF_ORIGINS=
# 세션 쿠키 서명 전용 키. API 의 DJANGO_SECRET_KEY 와 다른 값을 쓴다.
WEB_BFF_SECRET_KEY=
# WEB_BFF_ALLOWED_HOSTS=*
# 리버스 프록시가 X-Forwarded-Proto 를 붙여줄 때만 1 로 켠다.
# USE_X_FORWARDED_PROTO=0

# --- 관리자 웹 (admin-web, 8002) ----------------------------------------------
# 점주 웹과 마찬가지로 DB에 접속하지 않고 /api/v1 만 호출한다.
#   ADMIN_BFF_CSRF_ORIGINS=https://54.116.95.188
ADMIN_BFF_CSRF_ORIGINS=
# api / 점주 웹과 각각 다른 값을 쓴다.
ADMIN_BFF_SECRET_KEY=
# ADMIN_BFF_ALLOWED_HOSTS=*

# --- 관리자 웹 바인딩 --------------------------------------------------------
# 기본값이 127.0.0.1 이라 별도 설정 없이도 외부에 노출되지 않는다.
# 다른 기기에서 8002 로 직접 붙어야 할 때만 0.0.0.0 으로 바꾼다.
# ADMIN_BIND=127.0.0.1

# --- 운영 배포에서만 사용 (Actions 가 주입) ----------------------------------
# HACKMIN_IMAGE=ghcr.io/geonha0507/hackmin:<sha>
# HACKMIN_WEB_IMAGE=ghcr.io/geonha0507/hackmin-web:<sha>
# HACKMIN_ADMIN_IMAGE=ghcr.io/geonha0507/hackmin-admin:<sha>
